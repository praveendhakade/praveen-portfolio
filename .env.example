# Optional public repository discovery. Requests are anonymous unless a token is set.
GITHUB_USERNAME=praveendhakade
GITHUB_API_ENABLED=true
GITHUB_TOKEN=
# Explicit allowlist: only these verified public repositories' README files are ingested.
GITHUB_KNOWLEDGE_REPOS=

# Optional grounded assistant. Without a key, the assistant returns curated matching evidence.
AI_PROVIDER_API_KEY=
AI_MODEL=
# For Google AI Studio: https://generativelanguage.googleapis.com/v1beta/openai/
AI_BASE_URL=https://api.openai.com/v1

# Optional persistent RAG database. Use a server-side PostgreSQL connection/pooler URL.
DATABASE_URL=
EMBEDDING_MODEL=
# Gemini example: gemini-embedding-2 (returns 1536 dimensions when called by this app)
# Random secret of at least 32 characters. Required with DATABASE_URL; used to hash visitor identifiers.
RATE_LIMIT_SALT=
# Calibrate with `npm run rag:evaluate` before enabling persistent vector answers.
RAG_MIN_SIMILARITY=
# Set after the deployment origin is confirmed.
NEXT_PUBLIC_SITE_URL=
